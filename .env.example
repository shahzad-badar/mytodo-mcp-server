# Copy this file to .env. These values are public identifiers, not secrets.

# Required
ENTRA_TENANT_ID=
RESOURCE_AUDIENCE=
RESOURCE_BASE_URL=

# Optional. SCOPES_SUPPORTED defaults to one scope per tool. HOST defaults to every interface.
# SCOPES_SUPPORTED=tools.hello tools.ping tools.test
# HOST=127.0.0.1

# OAuth proxy for Claude. Entra has no dynamic client registration.
OAUTH_PROXY_ENABLED=false
ENTRA_CLIENT_ID=
# OAUTH_PROXY_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
# OAUTH_PROXY_ALLOW_LOOPBACK=false
# ENTRA_CLIENT_SECRET=

# Local development only. A deployment must never set these values.
# AS_ISSUER=http://127.0.0.1:9001
# AS_JWKS_URI=http://127.0.0.1:9001/jwks
# DEV_AUTH_USER=you@yourorg.com
# DEV_AUTH_KEY_FILE=.dev-auth/signing-key.json
# DEV_AUTH_PORT=9001
