# The bootstrap scripts and scripts/check-apply-roles.sh read this file. All values are public.
# infra/mcp/env/<env>.tfvars sets the project of each environment.

# PREFIX starts the name of every bootstrap resource and state bucket.
# It has 4 to 20 lowercase letters, digits or hyphens. It starts with a letter.
# Bucket names are global in GCP. Choose a unique prefix.
PREFIX=mytodo-mcp

# This project holds the state buckets, the identity pools and the Terraform identities.
TOOLS_PROJECT=ai-enablement-dev-0cf5f

# The value is the owner/name of this repository.
GITHUB_REPO=BentleySystems/mytodo-mcp-server

# The state buckets use this location.
STATE_BUCKET_LOCATION=us-central1
